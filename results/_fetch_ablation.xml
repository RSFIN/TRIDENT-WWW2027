RHE2HauMN4f\">—*</p></td><td vertical-align=\"top\"><p id=\"doxcnM17ANWWibTWmUGoKCIRURb\">0.000</p></td><td vertical-align=\"top\"><p id=\"doxcnK4G4DKiqibnNGvuIKObagc\">0.768</p></td></tr><tr><td vertical-align=\"top\"><p id=\"doxcnUTyvnmBOmh2bbqjR0thwbf\">R12-QP 1-shot [12]</p></td><td vertical-align=\"top\"><p id=\"doxcnzDgotYuQ6XOqvpR31YcKjc\">0.503</p></td><td vertical-align=\"top\"><p id=\"doxcngdjUIFcSJSxCrHlGGNVzfd\">—*</p></td><td vertical-align=\"top\"><p id=\"doxcnFWL4UPQNghn5kLnGqEiHCf\">0.721</p></td><td vertical-align=\"top\"><p id=\"doxcnOK1IR3MiBcCObaVr0bQJSg\">—*</p></td><td vertical-align=\"top\"><p id=\"doxcncHUcmpTuPwLXZ1dEhg45Kf\">5.0固定</p></td><td vertical-align=\"top\"><p id=\"doxcnKE4nvFLXleGrHE3JqfwLDc\">0.062</p></td><td vertical-align=\"top\"><p id=\"doxcnRovexxUN5meHl0kdSERJNe\">0.738*</p></td><td vertical-align=\"top\"><p id=\"doxcn9zhYWVWTUC1HO3HFsFZaDf\">—*</p></td><td vertical-align=\"top\"><p id=\"doxcnt5y6v2VQ6399xKn4yRRXvd\">—*</p></td><td vertical-align=\"top\"><p id=\"doxcneOskW7PPw88wANnIv1caVe\">0.701</p></td></tr><tr><td vertical-align=\"top\"><p id=\"doxcnwNzG6mYiNVs3JU7DV1ObZb\">R12-QP 5-shot [12]</p></td><td vertical-align=\"top\"><p id=\"doxcnWHR6d2YSLkj59V16eSzlYd\">0.706</p></td><td vertical-align=\"top\"><p id=\"doxcnLHAHxbaGnsHgJElIuJxwEh\">—*</p></td><td vertical-align=\"top\"><p id=\"doxcn3MpLiWUOUGywH7vlwrNtXe\">0.885</p></td><td vertical-align=\"top\"><p id=\"doxcnZkhUlPorcReNs7bVlzVwdb\">—*</p></td><td vertical-align=\"top\"><p id=\"doxcncxKCqipZYl0jDa11Catinh\">5.0固定</p></td><td vertical-align=\"top\"><p id=\"doxcngrpQJ2SPQXqOs4bGIPwIhg\">0.141</p></td><td vertical-align=\"top\"><p id=\"doxcnRP1bYgKNHFWoUIbfBjKdzf\">0.585*</p></td><td vertical-align=\"top\"><p id=\"doxcn3Q3lX3PiouXHTcvElN8Qlf\">—*</p></td><td vertical-align=\"top\"><p id=\"doxcn9xfm6S1jytzjMfNPPV6MMh\">—*</p></td><td vertical-align=\"top\"><p id=\"doxcnBTLMTG8Std6vBJFFM1esDb\">0.812</p></td></tr><tr><td vertical-align=\"top\"><p id=\"doxcnvio7L3CyevZYdDZk3LyC9g\">R12-QP 10-shot [12]</p></td><td vertical-align=\"top\"><p id=\"doxcn7tfW74Nv92HnOqPqg9XlPf\">0.761</p></td><td vertical-align=\"top\"><p id=\"doxcnPlSJkPP9CZ7kGswQsXRG1e\">—*</p></td><td vertical-align=\"top\"><p id=\"doxcnhENexSFCnkZQa1WFMyUmsc\">0.921</p></td><td vertical-align=\"top\"><p id=\"doxcnEAogdakCTtc1IYON1CQPkc\">—*</p></td><td vertical-align=\"top\"><p id=\"doxcndbOicOysObWY5xxGbZe1Qh\">5.0固定</p></td><td vertical-align=\"top\"><p id=\"doxcnn09ycv232rAacMahSXcwUh\">0.178</p></td><td vertical-align=\"top\"><p id=\"doxcnTGbOEcoeSkLXCimySyi0Lh\">0.536*</p></td><td vertical-align=\"top\"><p id=\"doxcnG4i0lOKMTwXeYu880TwFlc\">—*</p></td><td vertical-align=\"top\"><p id=\"doxcn4TjwwIM3PaDSuZes4V70eb\">—*</p></td><td vertical-align=\"top\"><p id=\"doxcnz4eiwa99JUoIR2BubbgC4d\">0.842</p></td></tr><tr><td vertical-align=\"top\"><p id=\"doxcnPiW76yF5WNLVvNyWxWgmxd\">R10 UniCR learned fusion [34]</p></td><td vertical-align=\"top\"><p id=\"doxcnbsNCefJ4HoS1ywh9KEgLve\">0.905</p></td><td vertical-align=\"top\"><p id=\"doxcnM7QbaZoe5ihO2MUfiJ7ljk\">0.867</p></td><td vertical-align=\"top\"><p id=\"doxcnIo31zHcF4RY84COFcqjerb\">0.867</p></td><td vertical-align=\"top\"><p id=\"doxcnAhIlvtTS7aMvw6MIG4lJ7d\">0.867</p></td><td vertical-align=\"top\"><p id=\"doxcnb75I6ERcuVB1GNwWLB6uT3\">0.87</p></td><td vertical-align=\"top\"><p id=\"doxcnbDcBTKw7Q38orvbb4kyN5b\">0.004</p></td><td vertical-align=\"top\"><p id=\"doxcn2OUX8YwKA8m2hcAjxAHIwh\">0.128</p></td><td vertical-align=\"top\"><p id=\"doxcnatUPNE9PH2KERPm7Zn5tfc\">1.000</p></td><td vertical-align=\"top\"><p id=\"doxcne4q11xuThRww02b24DxhEf\">0.000</p></td><td vertical-align=\"top\"><p id=\"doxcnj47jQjMIKBeYsxSyH3h0Ff\">0.975</p></td></tr></tbody></table><p id=\"doxcnf3YlqEVwGQkeeEMSuPcVwb\"><b>T2a 结论</b>：Ours 在 Macro-F1（+13.5pt vs 最强 10-shot QP）和 OOS AUROC（+13.3pt vs 0.842）双领先；CICC/MULACONF 为达 coverage 输出 78–135 个意图的巨大集合，Ours 在统一口径下 Cov(J≥0.5)=Cov(含)=0.853（贴近名义 α=0.1），avg set=0.86（含拒识 ∅）。QP-OneModel set size 固定为 5 不随难度自适应，1-shot/5-shot coverage 不达标。校准与拒识：Ours ECE=0.005（15-bin，top1-fused 置信度）远优于全部外部基线（0.062–0.178）；Ours 误拒率=0.143，同时 OOS 拒识率=100%——更严的 OOS 拒绝与更低的 in-domain 误拒同时成立。与 learned fusion 对比：R10（UniCR，logistic 学参融合）在 CLINC150 上仅以 +0.9pt F1、−1.5pt 误拒率微弱领先，但需在 calib 上拟合四维特征头，且在多意图数据集上集合能力退化（见 T2b）；Ours 以零训练的 rank 归一化融合达到与之相当的 coverage（0.853 vs 0.867）与校准（ECE 0.005 vs 0.004）——免训练不是性能代价，而是与学参融合等价的能力。</p><h3 id=\"doxcnOIzX8jRpe1lqD6iDQjWlJb\">T2b MixATIS / MixSNIPS 多意图结果</h3><table id=\"doxcnzvmyTa2KPcAsAN9FJjsfOe\"><colgroup><col width=\"123\"/><col width=\"78\"/><col width=\"78\"/><col width=\"78\"/><col width=\"78\"/><col width=\"115\"/><col width=\"80\"/><col width=\"78\"/><col width=\"80\"/><col width=\"78\"/></colgroup><thead><tr><th vertical-align=\"top\"><p id=\"doxcnRwDXrV35qj9I3G8xWBwaZd\">方法 / 数据集</p></th><th vertical-align=\"top\"><p id=\"doxcnR1nRmc83Z6wnLsargwjhrf\">Set IoU</p></th><th vertical-align=\"top\"><p id=\"doxcnMCyK1XYtAZ7HN6rMcS2EMZ\">Hit@1</p></th><th vertical-align=\"top\"><p id=\"doxcnOVLtgK6hk86DOpoCU7y7gJ\">Hit@3</p></th><th vertical-align=\"top\"><p id=\"doxcnZv9GzFnou35zPuIOQ6iwph\">Avg set</p></th><th vertical-align=\"top\"><p id=\"doxcnsbIeSlIOcZobiN4NhXQ2ce\">Cov(J≥0.5)</p></th><th vertical-align=\"top\"><p id=\"doxcnJUXfXG1P0SseTWWcnHensg\">Cov(含)</p></th><th vertical-align=\"top\"><p id=\"doxcnOPT5pcJfoMgsYzAQEGM3Cg\">ECE</p></th><th vertical-align=\"top\"><p id=\"doxcn9BP4itzXCOlJhVprFEFCMg\">误拒率</p></th><th vertical-align=\"top\"><p id=\"doxcnuFPEG0n37SiO2jqX99bNHd\">澄清率</p></th></tr></thead><tbody><tr><td vertical-align=\"top\"><p id=\"doxcnBTOe4U7Xkj4sYc7xXDGJHg\"><b>Ours / MixATIS</b></p></td><td vertical-align=\"top\"><p id=\"doxcnKrrgSRuXWopAU1wfdTPBwe\"><b>0.221</b></p></td><td vertical-align=\"top\"><p id=\"doxcn38xYkmBcNCULqLvcbpxYje\">0.086</p></td><td vertical-align=\"top\"><p id=\"doxcn4HkCdFXF204PV7QZfDh1HP\"><b>0.277</b></p></td><td vertical-align=\"top\"><p id=\"doxcnGKysPhJUMDfkgjPRFPcXfg\"><b>3.16</b></p></td><t